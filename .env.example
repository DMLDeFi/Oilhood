# ---------------------------------------------------------------
# OilHood Terminal configuration. Copy to .env.local and fill in.
# Everything is optional: the site runs with placeholders until set.
# ---------------------------------------------------------------

# $OILHOOD token contract on Robinhood Chain (set after launching on Pons)
NEXT_PUBLIC_OILHOOD_ADDRESS=

# Pre-launch countdown shown in the hero (ISO time with timezone). Hidden once the address is set.
NEXT_PUBLIC_LAUNCH_DATE=2026-11-05T18:00:00Z

# Direct link to the $OILHOOD page on Pons (defaults to https://pons.family)
NEXT_PUBLIC_PONS_URL=

# Tokenized stock contracts on Robinhood Chain (verify on the Blockscout explorer)
NEXT_PUBLIC_USO_TOKEN_ADDRESS=
NEXT_PUBLIC_XOM_TOKEN_ADDRESS=

# Wallet that receives Pons creator fees (shown in the fee tracker)
NEXT_PUBLIC_CREATOR_WALLET=

# Socials
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Optional: enables WalletConnect (mobile wallets). Get one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: public site URL, used for social share images
NEXT_PUBLIC_SITE_URL=https://oilhood.xyz

# ---------------------------------------------------------------
# On-chain indexer + Virtual Rigs (server-side, never exposed to the browser)
# ---------------------------------------------------------------

# Postgres connection string. Easiest: Vercel → Storage → Create → Neon (free), it sets this for you.
DATABASE_URL=

# Random secret that protects /api/sync. Generate one: openssl rand -hex 32
# Also add it as a GitHub Actions secret named CRON_SECRET.
CRON_SECRET=

# Block number the $OILHOOD contract was deployed in (from the explorer). Indexing starts here.
OILHOOD_START_BLOCK=

# Optional: pool / bonding-curve addresses $OILHOOD trades against (comma-separated).
# DexScreener pools are detected automatically; add the Pons curve here if trades show as "transfer".
OILHOOD_POOLS=

# Optional: a dedicated RPC (Alchemy/QuickNode/etc.) if the public Robinhood Chain RPC rate-limits you.
RPC_URL=
